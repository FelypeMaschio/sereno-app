# Copie este arquivo para ".env" e preencha com os endereços das APIs.
# Variáveis EXPO_PUBLIC_ ficam embutidas no app: coloque aqui só URLs, nunca segredos.
#
# Emulador Android: use 10.0.2.2 para acessar o localhost do seu PC.
# Celular físico (Expo Go): use o IP do PC na rede (ex.: http://192.168.0.15:8080).
EXPO_PUBLIC_API_JAVA_URL=
EXPO_PUBLIC_API_DOTNET_URL=
EXPO_PUBLIC_API_IA_URL=
# true = usa dados de exemplo (mocks) no lugar das APIs reais
EXPO_PUBLIC_USE_MOCK=true
