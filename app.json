{
  "expo": {
    "name": "Sereno",
    "slug": "sereno-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.fiap.sereno"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F6F6B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "package": "br.com.fiap.sereno",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1F6F6B"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Sereno usa sua localização só quando você pede um lugar calmo por perto. Ela não sai do seu celular."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Sereno usa suas fotos só para você escolher a foto de perfil, que fica guardada neste aparelho.",
          "cameraPermission": "O Sereno usa a câmera só para você tirar a foto de perfil, que fica guardada neste aparelho.",
          "microphonePermission": false
        }
      ]
    ],
    "backgroundColor": "#F6F3EC",
    "owner": "felypemaschio",
    "extra": {
      "eas": {
        "projectId": "a4f7f4b8-c3e8-4017-a6f5-c270739bf523"
      }
    }
  }
}
